# Shared
APP_ENV=local

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# API
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nakama_estimate
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BOOTSTRAP_TOKEN=change-me-before-first-setup

# S3-compatible storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_TTL_SECONDS=900

# Backend only: JSON object keyed by LOCAL tenant UUID; no global/default tenant credentials.
# Provision through the deployment secret store. Never NEXT_PUBLIC_*.
# Values/IDs must come from that tenant's licensed DATEV contract/catalogs.
DATEV_TENANTS={}
# Per-tenant fields: base_url, token_url, client_id, client_secret, authorization_key,
# scope, client_credentials_confirmed (default false), payment_method_id,
# payment_type_id, vat_codes (exact rate string such as "22.00" -> verified DATEV ID).
# No configuration option enables document creation or SdI in this phase.

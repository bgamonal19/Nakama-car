# Shared
APP_ENV=local

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# API
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nakama_estimate
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BOOTSTRAP_TOKEN=change-me-before-first-setup

# S3-compatible storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_TTL_SECONDS=900

# Plate lookup (targa.co.it). Empty = disabled.
TARGA_API_USERNAME=
PLATE_LOOKUP_MONTHLY_LIMIT=300

# Vehicle pictures for the damage map (carimage.dev). Empty = generic outline.
CAR_IMAGE_API_KEY=
CAR_IMAGE_MONTHLY_LIMIT=500

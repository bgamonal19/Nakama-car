# Shared
APP_ENV=local

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# API
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/nakama_estimate
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
BOOTSTRAP_TOKEN=change-me-before-first-setup

# S3-compatible storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_TTL_SECONDS=900
